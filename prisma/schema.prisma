// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?

  // Preferences (stored as JSON)
  preferences Json?
  mbtiType    String? // Stored as string e.g., "INFJ"

  // Relations
  journalEntries JournalEntry[]
  tags           Tag[]
  categories     Category[]
  accounts       Account[]
  sessions       Session[]
  moods          Mood[]
  goals          Goal[]
  insights       Insight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Journal & Reflections
// ============================================

model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  content   String // Rich text stored as JSON or Markdown
  mood      String? // happy, calm, anxious, reflective, etc.
  wordCount Int?

  isArchived Boolean @default(false)
  isPrivate  Boolean @default(false)

  // Relations
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  deletedAt  DateTime?
  tags       Tag[]

  // New Relations
  moodEntry Mood[]
  goals     Goal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Categories & Collections
// ============================================

model Category {
  id      String         @id @default(cuid())
  name    String
  color   String         @default("#a855f7") // Default purple
  icon    String?
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// ============================================
// Mood Tracking & Analysis
// ============================================

model Mood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  journalId    String?
  journalEntry JournalEntry? @relation(fields: [journalId], references: [id])

  moodValue     Int // 1-10
  emotions      String // JSON array of strings e.g., ["sad", "anxious"]
  intensity     Int? // 1-5
  physicalState Json? // { energy: 5, sleep: 7, exercise: true }
  context       String? // JSON array e.g., ["work", "health"]
  notes         String?

  recordedAt DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

// ============================================
// Goals & Personal Growth
// ============================================

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String? // health, career, relationships

  targetDate DateTime?
  status     String    @default("active") // active, paused, completed, abandoned
  progress   Int       @default(0) // 0-100

  // Relations
  linkedEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// AI Insights & Patterns
// ============================================

model Insight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String // pattern, growth, value_alignment, mbti_specific
  title      String
  content    String @default("")
  importance Int    @default(1) // 1-5

  generatedAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// Tags (Enhanced)
// ============================================

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  color     String?
  frequency Int     @default(1)

  // Relations
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}
